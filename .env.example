# Copy to .env for local development. Never commit real secrets.

# Database (local docker-compose defaults)
DB_NAME=storekeeper
DB_USER=storekeeper
DB_PASSWORD=change-me-locally
DB_HOST=db
DB_PORT=3306

# WordPress multisite
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_DOMAIN=localhost
WP_SUBDOMAIN_INSTALL=false

# libsodium key for encrypting gateway/WhatsApp/SMS secrets at rest (§19.4).
# Generate with: php -r "echo base64_encode(sodium_crypto_secretbox_keygen());"
WSP_ENCRYPTION_KEY=

# Test database for PHPUnit integration tests
SK_TEST_DSN=mysql:host=127.0.0.1;port=3307;dbname=storekeeper_test;charset=utf8mb4
SK_TEST_DB_USER=root
SK_TEST_DB_PASS=
