{
    "name": "storekeeper/storekeeper",
    "description": "Store Keeper - hosted wholesale commerce platform for Nigerian wholesalers and retailers.",
    "type": "project",
    "license": "proprietary",
    "private": true,
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "StoreKeeper\\Commerce\\": "plugins/storekeeper-commerce/src/",
            "StoreKeeper\\Platform\\": "plugins/storekeeper-platform/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StoreKeeper\\Commerce\\Tests\\": "plugins/storekeeper-commerce/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find plugins -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 -P4 php -l"
    }
}
